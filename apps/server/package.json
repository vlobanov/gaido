{
  "name": "@gaido/server",
  "version": "0.1.0",
  "description": "Gaido server — Fastify + tRPC + SQLite orchestrator with the bundled web UI.",
  "license": "MIT",
  "author": "Vadim Lobanov <vadim@lobanov.pw>",
  "homepage": "https://gaido.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vlobanov/gaido.git",
    "directory": "apps/server"
  },
  "bugs": "https://github.com/vlobanov/gaido/issues",
  "type": "module",
  "engines": {
    "node": ">=20.10"
  },
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./router": "./src/routers/index.ts"
  },
  "files": [
    "src",
    "migrations",
    "web-dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "prepack": "node scripts/prepack.mjs"
  },
  "dependencies": {
    "@gaido/core": "workspace:*",
    "@trpc/server": "^11.0.0",
    "fastify": "^5.0.0",
    "@fastify/websocket": "^11.0.0",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^8.0.3",
    "drizzle-orm": "^0.36.4",
    "better-sqlite3": "^11.5.0",
    "jiti": "^2.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.1"
  }
}
