{
  "name": "gaido-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10"
  },
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' --filter='./apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --parallel --filter='./apps/server' --filter='./apps/web' dev",
    "clean": "pnpm -r exec rm -rf dist node_modules .turbo"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
